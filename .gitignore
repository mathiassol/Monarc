# ---- Obsidian: keep shared vault config, drop per-machine UI state ----
# Plugin code is installed by Obsidian per-machine, and includes binaries.
# community-plugins.json still records which plugins the vault uses.
.obsidian/plugins/
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

